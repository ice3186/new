# Elation Health API Configuration
ELATION_API_KEY=your_api_key_here
ELATION_API_SECRET=your_api_secret_here
ELATION_BASE_URL=https://api.elationhealth.com
ELATION_PATIENT_ID=your_patient_id

# Alert Configuration
ALERT_EMAIL_FROM=alerts@example.com
ALERT_EMAIL_TO=your_email@example.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username
SMTP_PASSWORD=your_smtp_password

# Twilio Configuration (optional, for SMS alerts)
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1234567890
TWILIO_TO_NUMBER=+1234567890

# Monitoring Configuration
CHECK_INTERVAL_HOURS=24
